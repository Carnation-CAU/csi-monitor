+static void espnow_init(void)
+{
+    ESP_ERROR_CHECK(esp_now_init());
+    ESP_ERROR_CHECK(esp_now_set_pmk((uint8_t *)"pmk1234567890123"));
+
+    esp_now_peer_info_t peer = {
+        .channel   = 0,
+        .ifidx     = WIFI_IF_STA,
+        .encrypt   = false,
+        .peer_addr = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff},
+    };
+    ESP_ERROR_CHECK(esp_now_add_peer(&peer));
+}
+
+static struct {
+    struct arg_int *set;
+    struct arg_end *end;
+} rf_channel_args;
+
+static int rf_channel_cmd(int argc, char **argv)
+{
+    if (arg_parse(argc, argv, (void **)&rf_channel_args) != ESP_OK) {
+        arg_print_errors(stderr, rf_channel_args.end, argv[0]);
+        return ESP_FAIL;
+    }
+
+    if (!rf_channel_args.set->count) {
+        uint8_t primary = 0;
+        wifi_second_chan_t secondary = WIFI_SECOND_CHAN_NONE;
+        ESP_ERROR_CHECK(esp_wifi_get_channel(&primary, &secondary));
+        printf("RF_CHANNEL,%u\n", primary);
+        return ESP_OK;
+    }
+
+    uint8_t channel = rf_channel_args.set->ival[0];
+    if (channel != 1 && channel != 6 && channel != 11) {
+        printf("RF_CHANNEL_ERROR,allowed=1|6|11\n");
+        return ESP_ERR_INVALID_ARG;
+    }
+
+    rf_control_packet_t packet = {
+        .magic = RF_CONTROL_MAGIC,
+        .version = RF_CONTROL_VERSION,
+        .channel = channel,
+    };
+    for (int i = 0; i < RF_SWITCH_REPEAT_COUNT; ++i) {
+        ESP_ERROR_CHECK(esp_now_send(BROADCAST_MAC, (uint8_t *)&packet, sizeof(packet)));
+        vTaskDelay(pdMS_TO_TICKS(RF_SWITCH_REPEAT_INTERVAL_MS));
+    }
+
+    vTaskDelay(pdMS_TO_TICKS(RF_SWITCH_DELAY_MS));
+    ESP_ERROR_CHECK(esp_wifi_set_channel(channel, WIFI_SECOND_CHAN_NONE));
+    printf("RF_CHANNEL,%u\n", channel);
+    return ESP_OK;
+}
+
+static void cmd_register_rf_channel(void)
+{
+    rf_channel_args.set = arg_int0(NULL, "set", "<1|6|11>", "Switch TX and RX Wi-Fi channel");
+    rf_channel_args.end = arg_end(2);
+
+    const esp_console_cmd_t cmd = {
+        .command = "rf_channel",
+        .help = "Query or switch the development RF channel",
+        .hint = NULL,
+        .func = &rf_channel_cmd,
+        .argtable = &rf_channel_args,
+    };
+    ESP_ERROR_CHECK(esp_console_cmd_register(&cmd));
+}
