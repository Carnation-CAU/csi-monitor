+} rf_control_packet_t;
+
+static void espnow_recv_cb(const esp_now_recv_info_t *info, const uint8_t *data, int data_len)
+{
+    if (!info || !data || data_len != sizeof(rf_control_packet_t)) {
+        return;
+    }
+
+    const rf_control_packet_t *packet = (const rf_control_packet_t *)data;
+    if (packet->magic != RF_CONTROL_MAGIC || packet->version != RF_CONTROL_VERSION
+            || (packet->channel != 1 && packet->channel != 6 && packet->channel != 11)) {
+        return;
+    }
+
+    if (packet->channel != g_current_channel && !g_pending_channel) {
+        g_pending_channel = packet->channel;
+        ESP_LOGI(TAG, "Channel switch requested: %u", packet->channel);
+    }
+}

