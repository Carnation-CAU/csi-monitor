  "input": {
    "name": "amplitude",
    "dtype": "float32",
    "shape": [950, 52],
    "axis_order": ["time", "subcarrier"],
    "description": "950 consecutive ESP32 CSI amplitude frames with 52 subcarriers"
  },
  "preprocessing": {
    "version": "amplitude-zscore-v1",
    "operation": "per-window, per-subcarrier z-score",
