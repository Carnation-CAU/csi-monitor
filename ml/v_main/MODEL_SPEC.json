      "other_motion": "other_motion"
    }
  },
  "output": {
    "type": "csi_gateway.activity.ActivityPrediction",
    "fields": [
      "label",
      "scores",
      "confidence",
      "first_sequence",
      "last_sequence",
      "window_finished_at",
      "model_version",
      "preprocessing_version"
