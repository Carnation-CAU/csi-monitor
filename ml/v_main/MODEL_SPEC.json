  "architecture": "efficientnet_b0",
  "framework": "PyTorch",
  "source": {
    "experiment": "ml/v5_1",
    "dataset": "ESP-Fi HAR",
    "checkpoint": "ml/v5_1/output/cross_validation/espfi/efficientnet_b0/fold-1/best.pt",
    "selection_rule": "architecture by highest four-fold mean test macro-F1; checkpoint by highest validation macro-F1 without using its test score",
    "validation_macro_f1": 0.9227692673079207,
    "cross_validation_test_macro_f1_mean": 0.9074943704616917,
