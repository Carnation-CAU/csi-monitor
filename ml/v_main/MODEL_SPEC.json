  },
  "runtime": {
    "adapter": "ml.runtime.TorchCnnActivityModel",
    "default_inference_hz": 5,
    "window_frames": 950,
    "motion_tail_seconds": 3.0,
    "integration_fall_score_threshold": 0.8,
    "alert_fusion_rule": "ml_and_radar_v1",
    "device": "CUDA, then MPS, then CPU with MPS-to-CPU runtime fallback"
  },
  "limitations": [
    "Public ESP-Fi HAR uses ESP32-C3 data rather than the target ESP32-S3 deployment.",
    "The selected checkpoint is a cross-validation fold checkpoint, not a full-data refit.",
